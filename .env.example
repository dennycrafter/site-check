# Anthropic API key (platform.claude.com > Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (sb_secret_...) or legacy service_role key (eyJ...)
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Model used to read photos
ANALYSIS_MODEL=claude-sonnet-5

# Fraction of AI calls to fail on purpose. 0 normally, 0.3 for the resilience demo.
SIMULATE_AI_FAILURE_RATE=0
